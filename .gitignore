# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser profiles (contain login cookies — sensitive)
.fb-profile/
.reddit-profile/
.youtube-profile/
.twitter-profile/
.quora-profile/
.pinterest-profile/
.linkedin-profile/

# per-user browser profiles (SaaS multi-user)
profiles/

# runtime data
data/
.twitter-account

# debug screenshots
*.png

# scratch / test files
test-*.js
yt-signup*.ts
scripts/test-eval.ts
scripts/instantly-to-sheets.ts

# Claude Code workspace
.claude/

# clerk configuration (can include secrets)
/.clerk/
